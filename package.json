{
  "name": "@zclaudia/agent-transcript-kit",
  "version": "0.1.0",
  "description": "Shared agent-transcript view model, headless reducer, and text utilities",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zclaudia/zclaudia-agent-transcript-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.test.json && node dist-test/tests/run.js",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
